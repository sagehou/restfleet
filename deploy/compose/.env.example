# Development-only secret paths and loopback bind. Secret values stay in ignored files.
RESTFLEET_POSTGRES_MIGRATOR_PASSWORD_FILE=./secrets/postgres-migrator-password
RESTFLEET_POSTGRES_APP_PASSWORD_FILE=./secrets/postgres-app-password
RESTFLEET_MIGRATOR_DATABASE_URL_FILE=./secrets/migrator-database-url
RESTFLEET_APP_DATABASE_URL_FILE=./secrets/app-database-url
RESTFLEET_BOOTSTRAP_TOKEN_FILE=./secrets/bootstrap-token
RESTFLEET_MASTER_KEY_FILE=./secrets/master-key
RESTFLEET_GRPC_TLS_CERT_FILE=./secrets/grpc-tls-cert
RESTFLEET_GRPC_TLS_KEY_FILE=./secrets/grpc-tls-key
RESTFLEET_SERVER_CA_BUNDLE_FILE=./secrets/server-ca-bundle
RESTFLEET_HTTP_BIND=127.0.0.1
RESTFLEET_GRPC_BIND=127.0.0.1
RESTFLEET_PUBLIC_URL=https://localhost:8080
RESTFLEET_GRPC_ENDPOINT=localhost:8443
RESTFLEET_GRPC_SERVER_NAME=localhost
